APP_NAME=Logistics
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=https://logistics.example.com

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=logistics
DB_USERNAME=logistics
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-root-me

CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_HOST=redis
REDIS_PORT=6379
BROADCAST_CONNECTION=reverb

SANCTUM_STATEFUL_DOMAINS=logistics.example.com
SESSION_DOMAIN=.logistics.example.com
FRONTEND_URL=https://logistics.example.com

REVERB_APP_ID=replace-me
REVERB_APP_KEY=replace-me
REVERB_APP_SECRET=replace-me
REVERB_HOST=logistics.example.com
REVERB_PORT=8080
REVERB_SCHEME=https
VITE_REVERB_APP_KEY=${REVERB_APP_KEY}
VITE_REVERB_HOST=${REVERB_HOST}
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
