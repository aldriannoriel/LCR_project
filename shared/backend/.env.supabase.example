# Supabase PostgreSQL connection for the native Alona PHP API
SUPABASE_DB_DSN=pgsql:host=db.YOUR_PROJECT_REF.supabase.co;port=5432;dbname=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=YOUR_SUPABASE_DATABASE_PASSWORD
SUPABASE_JWT_SECRET=YOUR_SUPABASE_JWT_SECRET
CORS_ALLOWED_ORIGINS=http://localhost:5173
ALONA_UPLOAD_DIR=storage/app/alona-registration
ALONA_UPLOAD_BASE_URL=/storage/alona-registration
